# mount point   fstype  device                  device2                 flags
/boot           emmc    /dev/block/mmcblk0p5
/recovery       emmc    /dev/block/mmcblk0p6
/cache          ext4    /dev/block/mmcblk0p8
/system         ext4    /dev/block/mmcblk0p9
/data           ext4    /dev/block/mmcblk0p12   length=-16384
/preload        ext4    /dev/block/mmcblk0p10   flags=display="Preload";wipeingui
/efs            ext4    /dev/block/mmcblk0p3    flags=display="EFS";backup=1

#extrenal memory
/external_sd    vfat    /dev/block/mmcblk1p1    /dev/block/mmcblk1     flags=display="MicroSD";storage;wipeinit;removable
/usb_otg        vfat    /dev/block/sda1         /dev/block/sda          flags=display="USB-OTG";storage;wipeinit;removable
